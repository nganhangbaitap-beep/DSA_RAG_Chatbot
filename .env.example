# .env.example — Template không có key thật

# ── Google Gemini API ─────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here

# ── Groq API (LLM phụ) ────────────────────────
GROQ_API_KEY=your_groq_api_key_here

# ── Model Configuration ───────────────────────
GEMINI_MODEL=gemini-flash-latest
GROQ_MODEL=llama3-70b-8192
EMBEDDING_MODEL=gemini-embedding-001

# ChromaDB Configuration
CHROMA_PERSIST_DIR=./chroma_db
CHROMA_COLLECTION_NAME=dsa_knowledge

# Chunking Configuration
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# RAG Configuration
TOP_K_RESULTS=8
TEMPERATURE=0.3
MAX_TOKENS=2048

# ── Google Sheets ─────────────────────────────
# Local: để trống, dùng file google_creds.json
# HuggingFace: điền vào Secret GOOGLE_CREDS_JSON
# GOOGLE_CREDS_JSON=